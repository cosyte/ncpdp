{
  "name": "@cosyte/ncpdp",
  "version": "0.1.8",
  "description": "NCPDP parser, serializer, and builder for Node.js and TypeScript: SCRIPT ePrescribing and Telecom pharmacy claims, lenient on parse, spec-clean on emit.",
  "keywords": [
    "ncpdp",
    "parser",
    "healthcare",
    "interoperability",
    "typescript",
    "serializer",
    "pharmacy",
    "e-prescribing",
    "script",
    "telecom",
    "claims",
    "builder"
  ],
  "homepage": "https://docs.cosyte.com/ncpdp",
  "bugs": {
    "url": "https://github.com/cosyte/ncpdp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/ncpdp.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "brace-expansion": ">=5.0.12 <6.0.0",
      "postcss": ">=8.5.23 <9.0.0",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "telecom": [
        "./dist/telecom/index.d.ts"
      ],
      "script": [
        "./dist/script/index.d.ts"
      ],
      "common": [
        "./dist/common/index.d.ts"
      ],
      "profiles": [
        "./dist/profiles/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./telecom": {
      "import": {
        "types": "./dist/telecom/index.d.ts",
        "default": "./dist/telecom/index.mjs"
      },
      "require": {
        "types": "./dist/telecom/index.d.cts",
        "default": "./dist/telecom/index.cjs"
      }
    },
    "./script": {
      "import": {
        "types": "./dist/script/index.d.ts",
        "default": "./dist/script/index.mjs"
      },
      "require": {
        "types": "./dist/script/index.d.cts",
        "default": "./dist/script/index.cjs"
      }
    },
    "./common": {
      "import": {
        "types": "./dist/common/index.d.ts",
        "default": "./dist/common/index.mjs"
      },
      "require": {
        "types": "./dist/common/index.d.cts",
        "default": "./dist/common/index.cjs"
      }
    },
    "./profiles": {
      "import": {
        "types": "./dist/profiles/index.d.ts",
        "default": "./dist/profiles/index.mjs"
      },
      "require": {
        "types": "./dist/profiles/index.d.cts",
        "default": "./dist/profiles/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "check": "pnpm run check:process && pnpm run check:test-selection && pnpm run check:changeset-bumps",
    "check:process": "cosyte-process check",
    "check:test-selection": "tsx scripts/check-test-selection.ts",
    "check:changeset-bumps": "tsx scripts/check-changeset-bumps.ts",
    "surface:record": "tsx scripts/record-public-surface.ts",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "check:documents": "pnpm check:readme && pnpm check:claude-card && pnpm check:catalog",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "quality:check": "cosyte-ratchet check --skip mutation",
    "quality:mutation": "cosyte-ratchet check --skip coverage",
    "quality:raise": "cosyte-ratchet raise",
    "mutate": "cosyte-mutate",
    "mutate:full": "cosyte-mutate full --config stryker.full.config.mjs",
    "bench:reading": "cosyte-bench run --suite bench/ncpdp.bench.mjs --target dist/index.mjs",
    "bench:compare": "cosyte-bench compare --suite bench/ncpdp.bench.mjs",
    "bench:budgets": "node bench/budgets.mjs",
    "bench:profile": "node --enable-source-maps bench/profile.mjs dist/index.mjs",
    "fuzz": "vitest run test/property",
    "examples": "tsx scripts/run-examples.ts",
    "clean": "rm -rf dist coverage",
    "pack:docs": "cosyte-process pack-docs",
    "attw": "tsx scripts/attw.ts",
    "version": "changeset version && cosyte-process sync-version && prettier --write package.json src/index.ts",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/bench": "^0.1.1",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/prettier-config": "^0.1.2",
    "@cosyte/process": "^0.1.7",
    "@cosyte/script-utils": "^0.1.13",
    "@cosyte/test-utils": "^0.1.4",
    "@cosyte/tsconfig": "^0.1.2",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^22.0.0",
    "fast-check": "4.10.2",
    "fast-xml-parser": "5.12.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
